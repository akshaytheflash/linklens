# LinkLens configuration
# Copy this file to .env and fill in what you need.
# None of these are required to get the app running, but they tune behaviour.

# Optional. Without this, the AI analysis is skipped and the app relies
# purely on heuristics. Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# How long the sandboxed browser gets to load the page (seconds)
ANALYSIS_TIMEOUT_SECONDS=40

# Longest URL we will accept (characters)
MAX_URL_LENGTH=2048

# Rate limiting (per IP)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Comma separated domain lists (optional)
# ALLOW_DOMAINS=example.com
# DENY_DOMAINS=

# Allow scanning targets that resolve to private/loopback IPs.
# Keep this false unless you are testing against local services.
ALLOW_PRIVATE_IPS=false

# Block punycode (xn--) domains outright.
BLOCK_PUNYCODE=true

# 0.0..1.0 fraction of log lines to actually emit (noise control)
LOG_SAMPLE_RATE=1.0

# Where rendered screenshots get stored (relative to project root)
SCREENSHOTS_DIR=app/static/screenshots

# Port for local dev (Render overrides via PORT env var)
PORT=8000
